# Copy to `.env` and fill in. Every value here has a default in
# `packages/shared/src/shared/config.py`; this file names the ones you are
# likely to change and the ones production refuses to start without.
#
# The defaults below are the *local* ones — `task dev` runs Postgres and Redis
# on 5433 and 6380 so they do not collide with a locally installed pair. Compose
# overrides both to the in-network names.

# --- environment --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# JSON logs in production, human-readable while developing.
LOG_JSON=true

# --- Telegram -----------------------------------------------------------------
# From @BotFather. Required in production; without it the bot cannot start.
BOT_TOKEN=
BOT_USERNAME=
# Long polling by default. Set USE_WEBHOOK=true with a public HTTPS base URL to
# switch — WEBHOOK_SECRET is then mandatory, because without it anyone who
# learns the URL can post fabricated updates.
USE_WEBHOOK=false
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
# Where the bot's own server binds. This is what the reverse proxy forwards to;
# WEBHOOK_BASE_URL is what Telegram is told. The built-in Docker Nginx expects
# the default port 8081 and path /telegram/webhook; update its config if either
# is changed. Ignored when polling.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081

# --- infrastructure -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/tg_manager
REDIS_URL=redis://localhost:6380/0

# --- API and panel ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Where the Mini App is served from. The full Compose stack exposes its Nginx
# frontend on 8080; when running `task miniapp` directly, use 5173 instead.
# For Telegram this must be the public HTTPS tunnel/domain and match BotFather.
WEBAPP_URL=http://localhost:8080
# Standalone account dashboard served below `/site/` by the same Nginx origin.
# The bot issues short-lived single-use links to this URL through `/website`.
WEBSITE_URL=http://localhost:8080/site/
WEBSITE_LOGIN_TTL_SECONDS=900
# Production refuses to start on `*` — name the panel's origin.
CORS_ORIGINS=*
# Production refuses to start on the placeholder. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- AI moderation (Business plan) --------------------------------------------
# Any OpenAI-compatible endpoint. The default LLM7 route is keyless; set
# AI_API_KEY only when the selected provider requires authentication.
AI_ENABLED=true
AI_BASE_URL=https://api.llm7.io/v1
AI_API_KEY=
AI_MODEL=DeepSeek-V4-Flash-0731
AI_COMPLETION_PATH=/chat/completions
AI_MAX_CONCURRENCY=4

# --- payments -----------------------------------------------------------------
# Telegram Stars needs no configuration. CryptoBot does: a token from @CryptoBot,
# which also signs the webhook. The built-in Nginx proxies the default webhook
# path /payments/cryptobot/webhook; a custom path also requires an Nginx change.
CRYPTOBOT_TOKEN=
# Open invoices against Crypto Pay's test host (testnet-pay.crypt.bot) instead of
# the live one. Its token comes from @CryptoTestnetBot and does not work on the
# live host — network and token change together. A test invoice settles in play
# money while the subscription is extended for real, so production refuses to
# start with CRYPTOBOT_TESTNET=true.
CRYPTOBOT_TESTNET=false

# --- platform operators -------------------------------------------------------
# Comma-separated Telegram user ids that may open the platform console and run
# global bans. Empty means nobody, which is the safe default.
SUPERADMIN_IDS=
# The private-chat command that replies with a button into the console. It is
# never published to Telegram's command menu, so nothing in the bot's UI hints
# that it exists — pick something nobody would type by accident. What actually
# guards the console is SUPERADMIN_IDS above: the command ignores everyone else,
# and so does every API route behind it. Letters, digits and underscores only,
# up to 32 characters, with or without the leading slash.
PANEL_COMMAND=console
