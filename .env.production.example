# Copy to .env.production and keep it outside version control.
APP_ENV=production
LOG_JSON=true

BOT_TOKEN=
BOT_USERNAME=chatkeeperpro_bot
USE_WEBHOOK=true
WEBHOOK_BASE_URL=https://panel.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
WEBAPP_URL=https://panel.example.com
WEBSITE_URL=https://panel.example.com/site/
WEBSITE_LOGIN_TTL_SECONDS=900
API_BASE_URL=https://panel.example.com
CORS_ORIGINS=https://panel.example.com
JWT_SECRET=
SUPERADMIN_IDS=

# These values are consumed by docker-compose.production.yml. Use unique values.
POSTGRES_DB=tg_manager
POSTGRES_USER=tg_manager
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional integrations. Empty means the corresponding UI action is hidden.
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.llm7.io/v1
AI_MODEL=DeepSeek-V4-Flash-0731
AI_COMPLETION_PATH=/chat/completions
AI_MAX_CONCURRENCY=4

# Named Tunnel token from Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=
