# Everything the build does not need. `.env` is the important one: it holds a
# live bot token, and a copy baked into an image outlives any `docker rm`.
.env
.env.*
!.env.example
!.env.production.example

.git
.github
.venv
node_modules
dist
*.tsbuildinfo
__pycache__
*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
htmlcov

# `node_modules` and `dist` above stay outside the context, but the Mini App
# sources are needed by the Dockerfile's `web` target. The Python stages copy
# only their three applications explicitly, so the panel is not baked into
# those runtime images.

PROMPT.md
.vscode
