    "/api/chats/{chat_id}/admins/sync": {
      "post": {
        "tags": [
          "chats"
        ],
        "summary": "Re-read the chat's administrator list from Telegram",
        "description": "Refresh the mirror the chat list is drawn from, and drop cached verdicts.\n\nTelegram sends no update on a promotion, so this is how a newly promoted\nadmin makes the chat appear in their panel without waiting for the bot to\nhappen to sync it.",
        "operationId": "syncChatAdmins",
        "security": [
          {
            "TelegramSession": []
          }
        ],
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Chat Id"
            }
