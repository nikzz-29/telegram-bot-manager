  "components": {
    "schemas": {
      "AdminRole": {
        "type": "string",
        "enum": [
          "owner",
          "admin"
        ],
        "title": "AdminRole"
      },
      "AuthRequest": {
        "properties": {
          "init_data": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Init Data"
          }
        },
        "type": "object",
        "required": [
          "init_data"
        ],
        "title": "AuthRequest",
        "description": "Raw `initData` string handed over by the Telegram WebApp SDK."
      },
      "AuthResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "AuthResponse"
      },
      "AuthUser": {
        "properties": {
          "tg_user_id": {
            "type": "integer",
            "title": "Tg User Id"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
